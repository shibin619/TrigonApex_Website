# Base URL of the Laravel API. Overrides runtimeConfig.public.apiBaseUrl
# in nuxt.config.ts (Nuxt maps NUXT_PUBLIC_* env vars automatically).
#
# Development: http://localhost:8000
# Production:  https://api.trigonapex.in (not live yet — do not assume so)
NUXT_PUBLIC_API_BASE_URL=http://localhost:8000
